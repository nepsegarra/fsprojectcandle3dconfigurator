<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h2 class="fw-bold text-center mb-4" style="color:#23086f">Reset Account</h2>
                    
                    <% if (error) { %>
                        <div class="alert alert-danger text-center"><%= error %></div>
                    <% } %>

                    <form action="/update-password" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Your Email</label>
                            <input type="email" name="email" class="form-control" placeholder="john@example.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="password" class="form-control" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="confirmPassword" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 fw-bold text-white py-2">UPDATE PASSWORD</button>
                    </form>
                    
                    <div class="text-center mt-3">
                        <a href="/login" class="text-decoration-none small text-muted">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer1') %>